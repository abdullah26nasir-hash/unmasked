{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unmasked-m4v8p1",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/parties/*"] },
  "compatibility_date": "2026-09-01",
